# ProxyCove MCP server — configuration is entirely from environment variables.
# Copy to .env (or pass with -e / docker run) and adjust. No secrets are baked into the image.

# Port the HTTP server listens on
MCP_PORT=4010

# Path the MCP endpoint is mounted at
MCP_SECRET_PATH=/mcp

# Base URL of the ProxyCove API.
# Self-hosting against the public API:
BACKEND_BASE_URL=https://proxycove.com

# Optional invite code forwarded by create_account (only needed while an
# instance runs a closed beta of its own API — leave empty for public use).
PUBLIC_API_INVITE_CODE=
